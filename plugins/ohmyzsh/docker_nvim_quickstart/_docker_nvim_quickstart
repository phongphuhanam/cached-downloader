#compdef dnvim

# Completion for docker_nvim_quickstart: mirrors `docker run <TAB>` for the
# image argument, plus container-name completion for `dnvim rm` and image
# completion for `dnvim rebuild`. Relies on _dnvim_images/_dnvim_containers
# from docker_nvim_quickstart.plugin.zsh, which Oh My Zsh loads first.
_docker_nvim_quickstart() {
    local -a subs
    subs=('ls:list locally-built *.nvim images' 'rebuild:force rebuild the nvim layer' 'rm:remove a dev container')

    if (( CURRENT == 2 )); then
        _dnvim_images
        _describe -t subcommands 'subcommand' subs
        return
    fi

    case "${words[2]}" in
        rebuild)
            if (( CURRENT == 3 )); then
                _dnvim_images
            elif (( CURRENT == 4 )); then
                compadd -- --enable-buildx
            fi
            return
            ;;
        rm)
            (( CURRENT == 3 )) && _dnvim_containers
            return
            ;;
    esac

    # Past a literal "--", hand off to `docker run`'s own completion for
    # flags/values (--network <TAB>, --gpus <TAB>, ...) -- the same
    # words-rewrite + _normal handoff zsh's own _sudo/_env/_nice use to
    # delegate to the wrapped command's completer.
    local i
    for (( i = 1; i <= ${#words}; i++ )); do
        [[ ${words[i]} == "--" ]] && break
    done
    if (( i <= ${#words} && CURRENT > i )); then
        words=(docker run "${(@)words[i+1,-1]}")
        CURRENT=$(( CURRENT - i + 2 ))
        _normal
    elif (( CURRENT <= i )); then
        # Before "--" (or before it's been typed at all): offer the
        # recognized options alongside whatever free-form username the
        # user might be typing.
        compadd -- --enable-buildx --
    fi
}

_docker_nvim_quickstart
